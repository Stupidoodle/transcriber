# Speech-to-text for the persona platform: OpenAI first, local faster-whisper fallback.
# Loopback only (127.0.0.1:8090).
[Unit]
Description=Transcriber (speech-to-text: OpenAI first, local faster-whisper fallback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=%h/Documents/informatik/transcriber
# The OpenAI key is shared with the WhatsApp tools: read it from there, don't copy it.
EnvironmentFile=-%h/Documents/informatik/whatsapp-mcp/.env
# Traces and metrics over OTLP/HTTP to the local Alloy. Logs stay out of OTLP: the
# service writes JSON lines to stdout, the journal keeps them and Alloy ships those.
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
Environment=OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=prod
Environment=OTEL_METRIC_EXPORT_INTERVAL=15000
Environment=OTEL_LOGS_EXPORTER=none
ExecStart=%h/.local/bin/uv run --frozen transcriber
Restart=always
RestartSec=5
# uvicorn shuts down cleanly on SIGTERM and then re-raises the signal, so `uv run`
# exits 143: that is a normal stop, not a failure.
SuccessExitStatus=143

[Install]
WantedBy=default.target
